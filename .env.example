# Chave secreta de sessão Flask
CADUNICO_SECRET=cadunico_tomeacu_chave_segura_2026_dev_prod

# String de Conexão do PostgreSQL (Supabase Transaction Pooler)
# Formato: postgresql://postgres.[PROJETO]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.cfcdmuffivnukleadiyl:SUA_SENHA_AQUI@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Chave de API do Cloudinary (Armazenamento de Anexos e Fotos de Visitas)
# Formato: cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_URL=cloudinary://1234567890:abcdefghijklmnopqrstuvwxyz@dxyznome

# Porta da Aplicação (Padrão 5000)
PORT=5000
